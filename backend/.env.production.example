# Production settings for Hostinger. Copy to backend/.env ON THE SERVER, then
# replace every value in <angle brackets>. Never commit the real .env.
#
# Layout (see docs/DEPLOY-HOSTINGER.md): one subdomain serves both the web app
# and the API, e.g. https://loans.<yourdomain.com>
#   /            -> web app (frontend build copied into backend/public)
#   /api/...     -> Laravel API

APP_NAME="DXCOVR Service & Loan Manager"
APP_ENV=production
# Generated on the server with: php artisan key:generate
# BACK IT UP: identity numbers are encrypted with it. Losing it loses that data.
APP_KEY=
APP_DEBUG=false
APP_URL=https://loans.<yourdomain.com>
FRONTEND_URL=https://loans.<yourdomain.com>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# hPanel > Databases > Management. Hostinger prefixes names with your user (u123456789_...).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_loans>
DB_USERNAME=<u123456789_loans>
DB_PASSWORD=<database password>

# The app and API share one address, so cookies stay on this subdomain only
# (no SESSION_DOMAIN). The cookie name is unique so it can't clash with the
# clinic ERP or any other Laravel app on the same domain.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=dxcovr_loans_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=loans.<yourdomain.com>
CORS_ALLOWED_ORIGINS=https://loans.<yourdomain.com>

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued: notifications and audit entries are written immediately.
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=dxcovr_loans_

# Not used by any current feature (staff password resets are done by an administrator).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@<yourdomain.com>
MAIL_FROM_NAME="${APP_NAME}"

# Customer SMS. "log" sends nothing; it only writes to storage/logs.
SMS_DRIVER=log
SMS_SENDER_ID=

# Onboarding biometrics. Leave "unconfigured" until a real integration exists.
# The simulator is refused in production regardless of these values.
BIOMETRICS_FACE_DRIVER=unconfigured
BIOMETRICS_FINGERPRINT_DRIVER=unconfigured
BIOMETRICS_ALLOW_SIMULATED=false
BIOMETRICS_SESSION_TTL=10
# DERMALOG ZF1+ capture bridge, once installed on the onboarding PCs (docs/BIOMETRICS.md)
FINGERPRINT_BRIDGE_MODE=match_on_card
FINGERPRINT_BRIDGE_URL=http://127.0.0.1:15896
FINGERPRINT_BRIDGE_SECRET=
FINGERPRINT_BRIDGE_MAX_AGE=300
FINGERPRINT_MIN_MATCH_SCORE=0.80
